{
  "name": "eisenhower-matrix-desktop",
  "version": "1.2.0",
  "private": true,
  "description": "Desktop wrapper for Eisenhower Matrix (a personal task scheduler)",
  "author": "Tatha",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tathas.schedule",
    "productName": "Eisenhower Matrix",
    "asar": true,
    "files": ["main.js", "assets/**/*"],
    "extraResources": [
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!data/**"] },
      { "from": "../frontend/dist", "to": "frontend/dist" }
    ],
    "win": {
      "target": ["nsis"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
